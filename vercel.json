{
  "version": 2,
  "builds": [
    { "src": "index.ts", "use": "@vercel/node" },
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "app.js", "use": "@vercel/static" },
    { "src": "manifest.webmanifest", "use": "@vercel/static" },
    { "src": "service-worker.js", "use": "@vercel/static" },
    { "src": "icon-192.png", "use": "@vercel/static" },
    { "src": "icon-512.png", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/", "dest": "/index.html" },
    { "src": "/(app\\.js|manifest\\.webmanifest|service-worker\\.js|icon-192\\.png|icon-512\\.png)", "dest": "/$1" },
    { "src": "/(poll|command|state)", "dest": "/index.ts" },
    { "src": "/(.*)", "dest": "/index.ts" }
  ]
}
